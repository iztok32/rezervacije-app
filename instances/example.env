# instances/example.env — SAMO PREDLOGA (v gitu).
# deploy.sh ob prvi postavitvi samodejno ustvari instances/<ime>.env; ročno kopiranje ni potrebno.

INSTANCE=example
APP_NAME=Rezervacije
APP_DOMAIN=example.epro.one
APP_URL=https://example.epro.one
APP_KEY=                              # ustvari se ob prvi postavitvi
DB_DATABASE=example
DB_USERNAME=example
DB_PASSWORD=                          # ustvari se ob prvi postavitvi

# Prva postavitev: administrator in predloge ponudbe (glej `php artisan preset:add`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_PRESETS=hairdresser              # npr. riding | group_classes | hairdresser | car_rental | glamping | hotel | court
SEED_SAMPLES=false                    # true = vzorčni viri, storitve, termini (demo)

# ── Neobvezno ───────────────────────────────────────────────────────────────
# APP_LOCALE=sl
# AVAILABLE_LOCALES=sl,en
# APP_TIMEZONE=Europe/Ljubljana
# MAIL_MAILER=smtp
